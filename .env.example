# Copia este archivo como .env.local y completa los valores
# (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional · Teselas del mapa. tile.openstreetmap.org no admite tráfico intenso
# de apps en producción: usa un proveedor con plan (MapTiler, Stadia...).
# VITE_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=TU_CLAVE
# VITE_TILES_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap

# Recomendado · Mapa minimalista CARTO Positron (clave gratuita, sin cuenta):
# https://carto.com/basemaps/apikey  — restríngela a tu dominio (redclima.vercel.app).
# VITE_CARTO_KEY=tu_clave
